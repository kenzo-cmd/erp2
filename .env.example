# Copy this file to .env.local and fill in your own values.
# Supabase dashboard -> Project Settings -> API Keys
#
# .env.local is gitignored. This example file is committed so a stranger
# cloning the repo knows what to provide.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# DO NOT put the service role key in this project.
# It bypasses every row level security policy. Anything prefixed
# NEXT_PUBLIC_ is compiled into the JavaScript your visitors download,
# so a service role key there hands your whole database to anyone who
# opens DevTools.
